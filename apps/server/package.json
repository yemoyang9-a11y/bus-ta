{
  "name": "@bus-ta/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "demo:bell": "tsx src/demo/bell-demo.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:boarding": "tsx --test src/integration/mobile-function-dispatcher.test.ts src/integration/mobile-event-dispatcher.test.ts src/services/trip/confirm-boarding.service.test.ts src/services/trip/update-trip-status.service.test.ts src/services/trip/get-trip-status.service.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bus-ta/shared": "workspace:*",
    "axios": "^1.18.1",
    "express": "^4.19.2",
    "openai": "^6.45.0",
    "tsx": "^4.15.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  }
}
