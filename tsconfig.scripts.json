{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": ["./apps/server/node_modules/@types"],
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts"]
}
